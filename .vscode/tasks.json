{
    "tasks": [
        //Build all
        {
            "label": "Build all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "type": "shell",
            "command": "make",
            "args": [
                "all",
                "-j4", 
                "GCC_PATH=/opt/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin",
                "-C${workspaceRoot}" //No se pueden dejar espacios !!
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiBlue"
            },
            "problemMatcher": []
        },
        //St-flash
        {
            "label": "St-Flash",
            "group": "build",
            "type": "shell",
            //Si pongo parte del commando en args deja de funcionar
            "command": "st-flash --connect-under-reset write ${workspaceFolder}/build/CubeMX.bin 0x8000000",
            "args": [
                ],
            "icon": {
                "id": "flame",
                "color": "terminal.ansiRed"
            },
            "problemMatcher": [],
            "dependsOn": [
                "Build all"
            ]
        },
        //Build clean
        {
            "label": "Clean",
            "group": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
                "GCC_PATH=/opt/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin",
                "-C${workspaceRoot}"
            ],
            "icon": {
                "id": "discard",
                "color": "terminal.ansiGreen"
            },
        },
        //Killall -9 st-util
        {
            "label": "Kill st-util",
            "group": "none",
            "type": "shell",
            "hide": true,
            "command": "killall -9 st-util",
            "args": [],
             "icon": {
                "id": "trash",
                "color": "terminal.ansiYellow"
            },
        },
        // CMake build
        {
            "label": "CMake: build",
            "type": "cmake",
            "command": "build",
            "hide": true,
            "targets": [
                "[N/A - Select Kit]"
            ],
            //"group": "build",
            "icon": {
                "id": "triangle-up",
                "color": "terminal.ansiBlue"
            },
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
