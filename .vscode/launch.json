
/*  [Launch.json attributes] list: https://code.visualstudio.com/docs/editor/debugging#_launchjson-attributes
    [Cortex-Debug attributes] list: https://github.com/Marus/cortex-debug/blob/master/debug_attributes.md
    [Wiki Cortex-Debug]: https://github.com/Marus/cortex-debug/wiki
    Configuration copied from: https://github.com/prtzl/Embedded_videos/tree/master/045_BUILDING-PT4/test-f407vg/.vscode
*/
{
    "version": "0.2.0",
    "projectName": "Discovery",
    "configurations": [

        //STlink attach
        {
            "name": "STlink attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "stlink", // cortex-debug no admite swo para stlink ni st-util
            "serverArgs": ["--shared", "--swo-port", "50005", "--verbose", "--log-level", "31"],
            "stlinkPath": "/opt/st/stm32cubeclt/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "/opt/st/stm32cubeclt/STM32CubeProgrammer/bin",
            "debuggerArgs": [],
            "device": "STM32F303VCT6", //STM32F303VC en caso de error
            "interface": "swd",
            "runToEntryPoint": "main", // else it starts at reset handler - not interested
            //"preAttachCommands": [""], //you can execute command instead of task
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "swoConfig": // currently (v1.7.0) not supported
            {
                "seoconfig": "disabled", // currently (v1.7.0) not supported
                "swoPath": "",
                "swoPort": "",
                "enabled": false,
                "cpuFrequency": 16000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0 output",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            },
            "showDevDebugOutput": "vscode",
            //"postDebugTask": "Kill st-util",
        },
        //STlink launch
        {
            "name": "STlink launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink", // cortex-debug no admite swo para stlink ni st-util
            "serverArgs": [/*"--swo-port", "50005",*/ "--verbose", "--log-level", "31"],
            "stlinkPath": "/opt/st/stm32cubeclt/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "/opt/st/stm32cubeclt/STM32CubeProgrammer/bin",
            "debuggerArgs": [],
            "device": "STM32F303VCT6", //STM32F303VC en caso de error
            "interface": "swd",
            "runToEntryPoint": "main", // else it starts at reset handler - not interested
            "preLaunchTask": "Build all", // IMPORTANTE para flashear el new binario. configured in tasks.json
            //"preLaunchCommands": [""], //you can execute command instead of task
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "swoConfig": {}, // currently (v1.7.0) not supported
            "showDevDebugOutput": "parsed",
            //"postDebugTask": "Kill st-util",
        },
        //JLink launch
        {
            "type": "cortex-debug", //define la lista de atributos para la config. mediante IntelliSense
            "name": "JLink launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F303VC",
            "interface": "swd",
            "runToEntryPoint": "main", // otherwise, it starts at reset handler - not interested
            "preLaunchTask": "Build all", // task configured in tasks.json
            "preLaunchCommands": [],
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "liveWatch": {
                "enabled": false,
                "samplesPerSecond": 4
            },
            "rttConfig": { //esta si que funciona por JLinkRTTViewerExe
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "swoConfig"://No consiguo que funcione ni x vscode ni por JLinkSWOViewerExe
            {
                "enabled": false,
                "cpuFrequency": 16000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }
        },
        //JLink attach
        {
            "type": "cortex-debug",
            "name": "JLink attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "attach",
            "servertype": "jlink",
            "device": "STM32F303VC",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preAttachCommands": [],
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "liveWatch": {
                "enabled": false,
                "samplesPerSecond": 4
            },
            "rttConfig": { //esta si que funciona por JLinkRTTViewerExe
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "swoConfig": //No consiguo que funcione ni x vscode ni por JLinkSWOViewerExe
            {
                "enabled": false,
                "cpuFrequency": 16000000,
                "swoFrequency": 2250000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }
        },
        //St-util launch => flash anytime
        {
            "name": "st-util launch",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stutil",
            //"serverArgs": ["--connect-under-reset"],
            "debuggerArgs": [],
            "device": "STM32F303VCT6", //STM32F303VC en caso de error
            "interface": "swd",
            "runToEntryPoint": "main", // otherwise, it starts at reset handler - not interested
            "preLaunchTask": "Build all", // configured in tasks.json
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "swoConfig":
            {
                "enabled": false, // currently (v1.7.0) not supported
                "cpuFrequency": 16000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0 output",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }, 
            //"showDevDebugOutput": "parsed",
            "postDebugTask": "Kill st-util", //para evitar el error: 
        },
        //St-util attach
        {
            "name": "st-util attach",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "stutil",
            //"serverArgs": ["--connect-under-reset"],
            "debuggerArgs": [],
            "device": "STM32F303VCT6", //STM32F303VC en caso de error
            "interface": "swd",
            "runToEntryPoint": "main", // else it starts at reset handler - not interested
            "svdFile": "${workspaceFolder}/STM32F303.svd" // Include svd to watch device peripherals
            //"showDevDebugOutput": "parsed",
            //"postDebugTask": "Kill st-util",
        },
        //SWO separada (serial) --- COPIADO DE CHATGPT => NO FUNCIONA
        {
            "name": "SWO Trace (Serial)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external", // no lanza gdbserver, solo abre SWO
            "gdbTarget": "localhost:50000",
            //"gdbTarget": "/dev/ttyACM0",
            "device": "STM32F303VC",  // tiene que estar para cortex-debug
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 16000000,
                "swoFrequency": 2000000,
                "source": "serial",
                "swoPath": "/dev/ttyACM0", //when source=serial
                //"swoPort": "localhost:50005", //when servertype=external && source=socket
                "decoders": [
                {
                        "label": "ITM -> USART",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            }
        }
    ],
    "compounds": [
        {
            "name": "Attach & SWO",
            "configurations": ["STlink attach", "SWO Trace (Serial)"]
        }
    ],
    "inputs": []
}