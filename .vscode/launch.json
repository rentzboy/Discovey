
/*  [Launch.json attributes] list: https://code.visualstudio.com/docs/editor/debugging#_launchjson-attributes
    [Cortex-Debug attributes] list: https://github.com/Marus/cortex-debug/blob/master/debug_attributes.md
    [Wiki Cortex-Debug]: https://github.com/Marus/cortex-debug/wiki
    Configuration copied from: https://github.com/prtzl/Embedded_videos/tree/master/045_BUILDING-PT4/test-f407vg/.vscode
*/
{
    "version": "0.2.0",
    "projectName": "Discovery",
    "configurations": [
        //Las config para st-util y st-link están en la rama stlink
        //JLink launch
        {
            "name": "JLink launch",
            "type": "cortex-debug", //define la lista de atributos para la config. mediante IntelliSense
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F303VC",
            "interface": "swd",
            "runToEntryPoint": "main", // otherwise, it starts at reset handler - not interested
            "preLaunchTask": "Build all", // task configured in tasks.json
            "preLaunchCommands": [],
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "liveWatch": 
            {
                "enabled": false,
                "samplesPerSecond": 4
            },
            "swoConfig"://no funciona
            {
                "enabled": false,
                "cpuFrequency": 16000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ],
            },
            "postLaunchCommands": 
                [
                    "monitor swo start 16000000 2250000" //ni con esto funciona SWO
                ],
            "rttConfig": 
            {
                "enabled": false,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        },
        //JLink attach
        {
            "name": "JLink attach",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/CubeMX.elf",
            "request": "attach",
            "servertype": "jlink",
            "device": "STM32F303VC",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preAttachCommands": [],
            "svdFile": "${workspaceFolder}/STM32F303.svd", // Include svd to watch device peripherals
            "liveWatch": {
                "enabled": false,
                "samplesPerSecond": 4
            },
            "swoConfig": //no funciona
            {
                "enabled": false,
                "cpuFrequency": 16000000,
                "swoFrequency": 2250000,
                "source": "probe",
                "decoders":
                [
                    {
                        "label": "ITM port 0",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ]
            },
            "postAttachCommands": [
                "monitor swo start 16000000 2250000" //ni con esto funciona SWO
            ],
            "rttConfig": {
                "enabled": false,
                "address": "auto",
                "decoders": [
                    {
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
        }
    ]
}