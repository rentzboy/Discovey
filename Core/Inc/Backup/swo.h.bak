/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef __SWO_H
#define __SWO_H

#ifdef __cplusplus
extern "C" {
#endif

//Prototypes
void SWO_PrintChar(char c);
void SWO_PrintString(const char *s);

#ifdef __cplusplus
}
#endif

#endif /* __SWO_H */
